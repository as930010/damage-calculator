{
  "name": "damage-calculator",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "test:transfer": "node --test scripts/loadout-transfer.test.mjs",
    "test:field-ids": "node --test scripts/field-ids.test.mjs",
    "test:data-loading": "node --test scripts/game-data-bundle.test.mjs",
    "test:data-schema": "node --test scripts/data-schema.test.mjs",
    "test:input-fields": "node --test scripts/input-field-validation.test.mjs",
    "test:history": "node --test tests/history.test.mjs",
    "test:evaluation": "node --experimental-vm-modules --test tests/loadout-evaluation.test.mjs",
    "test:catalog": "node --experimental-vm-modules --test tests/catalog-index.test.mjs",
    "test:ui": "node --experimental-vm-modules --test tests/ui-updates.test.mjs tests/picker-lifecycle.test.mjs tests/optional-inputs.test.mjs",
    "test:buff": "node --experimental-vm-modules --test features/buff-simulator/tests/events.test.mjs",
    "test:theme-isolation": "node --test tests/theme-isolation.test.mjs",
    "test:core": "node --test tests/attack-calculation.test.mjs tests/cap-warnings.test.mjs tests/class-passive-validation.test.mjs tests/confirmed-corrections.test.mjs tests/global-input-projection.test.mjs tests/example-parity.test.mjs tests/right-ice-set-validation.test.mjs tests/nephron-armor.test.mjs tests/numeric-input.test.mjs tests/requested-regressions.test.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:build": "node --test tests/production-assets.test.mjs",
    "test:production": "node --experimental-vm-modules --test tests/production-smoke.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
